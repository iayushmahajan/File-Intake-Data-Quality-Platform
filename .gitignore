.venv
__pycache__
.pytest_cache
*.pyc
.git
.gitignore
!data/input/.gitkeep
!data/output/.gitkeep
file_processing.db
backend/data/input/*
backend/data/output/*

!backend/data/input/.gitkeep
!backend/data/output/.gitkeep
backend/.env
.env
.env.*
!.env.example
!backend/.env.example
!frontend/.env.example
frontend/node_modules/
frontend/dist/
*.tsbuildinfo
frontend/playwright-report/
frontend/test-results/
backend/data/*.db

# Flights benchmark bytes remain local-only, including accidental copies.
**/dirty.csv
**/clean.csv

# Keep local download metadata and duplicate screenshot archives out of Git.
*:Zone.Identifier
/docs/ui-review/live-workflow.zip
