{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run full project",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/run.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": []
    },
    {
      "label": "Stop backend services",
      "type": "process",
      "command": "docker",
      "args": ["compose", "-p", "file-intake-processing-service", "stop"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
